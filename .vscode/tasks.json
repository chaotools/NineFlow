{
  "version": "0.2.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "C:\\Users\\0409\\dotnet\\dotnet.exe",
      "args": [
        "build",
        "${workspaceFolder}/src/NineFlow.Wpf/NineFlow.Wpf.csproj",
        "-c",
        "Debug"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run",
      "type": "process",
      "command": "C:\\Users\\0409\\dotnet\\dotnet.exe",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/NineFlow.Wpf/NineFlow.Wpf.csproj"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "process",
      "command": "C:\\Users\\0409\\dotnet\\dotnet.exe",
      "args": [
        "build",
        "${workspaceFolder}/tests/NineFlow.Tests/NineFlow.Tests.csproj",
        "-c",
        "Debug"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish-exe",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/build.ps1"
      ],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
