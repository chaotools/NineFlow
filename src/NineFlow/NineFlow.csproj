<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NineFlow</RootNamespace>
    <AssemblyName>NineFlow</AssemblyName>

    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationDefaultFont>Microsoft YaHei UI, 9pt</ApplicationDefaultFont>

    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>九序</AssemblyTitle>
    <Product>九序</Product>
    <Description>九序 · 多键连发 · 智能续点 · 转发助手</Description>
    <AssemblyInformationalVersion>九序 1.1.7 (NineFlow)</AssemblyInformationalVersion>
    <Company>NineFlow</Company>
    <Copyright>Copyright © 2026 NineFlow</Copyright>
    <Version>1.1.7</Version>
    <FileVersion>1.1.7.0</FileVersion>
    <AssemblyVersion>1.1.7.0</AssemblyVersion>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ErrorReport>none</ErrorReport>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NineFlow.Core\NineFlow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\app.ico" LogicalName="NineFlow.app.ico" />
  </ItemGroup>

</Project>
