<Window x:Class="NineFlow.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="九序 · 已停止"
        Width="880" MinWidth="760" MinHeight="320" MaxHeight="820"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/app.ico"
        Background="White"
        FontFamily="Microsoft YaHei UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- 「极简单面板」：一整块白面，没有卡片、没有描边，只有发丝线；
         顶栏 44 / 列头 26 / 行区 * / 添加 36 / 页脚 42 / 状态 22 -->
    <Grid Margin="18,6,18,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="26" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
            <RowDefinition Height="42" />
            <RowDefinition Height="22" />
        </Grid.RowDefinitions>

        <!-- ============ 顶栏 ============ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="DotState" Width="7" Height="7" Fill="{StaticResource TextTertiaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,7,0" />
                <TextBlock x:Name="TxtPill" Text="已停止" FontSize="11.5"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <Button x:Name="BtnStart" Grid.Column="1" Content="开始连点"
                    Style="{StaticResource PrimaryButton}" Width="92" Height="30"
                    FontSize="12" Margin="18,0,8,0"
                    ToolTip="{Binding Text, ElementName=TxtSummary}" />

            <Button x:Name="BtnReset" Grid.Column="2" Content="重置"
                    Style="{StaticResource SecondaryButton}" Width="64" Height="30"
                    FontSize="12" />

            <TextBlock x:Name="TxtTarget" Grid.Column="3" Text="目标窗口：未选择"
                       FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"
                       MaxWidth="240" Margin="0,0,0,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- ============ 列头（与行模板同一套列宽） ============ -->
        <Border x:Name="HeaderRow" Grid.Row="1" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="74" />
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="26" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="有效" Style="{StaticResource ColumnHead}" />
                <TextBlock Grid.Column="1" Text="组合按键" Style="{StaticResource ColumnHead}" Margin="10,0,0,0" />
                <TextBlock Grid.Column="2" Text="间隔（秒）" Style="{StaticResource ColumnHead}"
                           HorizontalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Grid.Column="3" Text="次数" Style="{StaticResource ColumnHead}"
                           HorizontalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Grid.Column="4" Text="本轮" Style="{StaticResource ColumnHead}"
                           HorizontalAlignment="Right" Margin="0,0,4,0" />
            </Grid>
        </Border>

        <!-- ============ 行进区 ============ -->
        <!-- 列表：行多了才出现滚动条，列头会自动让出同样的宽度（见 SyncListGutter） -->
        <ScrollViewer x:Name="RowsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="RowsList" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="54" BorderBrush="{StaticResource RowLineBrush}" BorderThickness="0,0,0,1"
                                SnapsToDevicePixels="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FBFBFD" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="74" />
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="26" />
                                </Grid.ColumnDefinitions>

                                <ToggleButton Grid.Column="0" Style="{StaticResource SwitchSmall}"
                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              IsEnabled="{Binding Editable}" VerticalAlignment="Center" />

                                <Border x:Name="KeyBorder" Grid.Column="1" Height="34" CornerRadius="7"
                                        Margin="8,0,12,0" VerticalAlignment="Center" Cursor="Hand"
                                        IsEnabled="{Binding Editable}" MouseLeftButtonDown="KeyBorder_MouseDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SubFillBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock x:Name="KeyText" Text="{Binding KeyDisplay}" Margin="10,0"
                                               FontSize="13" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>

                                <TextBox x:Name="IntervalBox" Grid.Column="2" Margin="0,0,12,0"
                                         Style="{StaticResource CompactField}"
                                         Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding Editable}" />

                                <TextBox x:Name="CountBox" Grid.Column="3" Margin="0,0,12,0"
                                         Style="{StaticResource PlainField}"
                                         Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding Editable}" />

                                <TextBlock x:Name="ProgressLabel" Grid.Column="4" Text="{Binding ProgressText}"
                                           FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Margin="0,0,4,0" Foreground="{StaticResource TextFaintBrush}" />

                                <Button Grid.Column="5" Content="✕" Style="{StaticResource RowDeleteButton}"
                                        VerticalAlignment="Center" HorizontalAlignment="Right"
                                        IsEnabled="{Binding CanRemove}" Click="RemoveRow_Click" />
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                <Setter TargetName="KeyText" Property="Foreground" Value="#8E8E96" />
                                <Setter TargetName="ProgressLabel" Property="Foreground" Value="#C2C2CA" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KeyEmpty}" Value="True">
                                <Setter TargetName="KeyText" Property="Foreground" Value="#B4B4BC" />
                                <Setter TargetName="KeyText" Property="FontSize" Value="11.5" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Capturing}" Value="True">
                                <Setter TargetName="KeyBorder" Property="Background" Value="{StaticResource RedSoftBrush}" />
                                <Setter TargetName="KeyText" Property="Foreground" Value="{StaticResource RedBrush}" />
                                <Setter TargetName="KeyText" Property="FontSize" Value="12" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ============ 添加一行 ============ -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnAddSlot" Content="＋ 添加一行" Style="{StaticResource AddRowButton}"
                    Click="AddSlot_Click" Width="98" />
            <TextBlock Text="点按键后直接按下目标键，Esc 取消 · 最少 2 行，最多 20 行"
                       FontSize="10" Foreground="{StaticResource TextFaintBrush}"
                       Margin="12,0,0,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- ============ 页脚：键帽 + 跳过数 + 设置 ============ -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource RowLineBrush}" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="TxtHotkeyOn" Style="{StaticResource KbdBox}" Text="F7" Width="34" />
                    <TextBlock Text="启动" Style="{StaticResource ChipLabel}" />
                    <TextBox x:Name="TxtHotkeyOff" Style="{StaticResource KbdBox}" Text="F8" Width="34" />
                    <TextBlock Text="停止" Style="{StaticResource ChipLabel}" />
                    <TextBox x:Name="TxtHotkeyReset" Style="{StaticResource KbdBox}" Text="F9" Width="34" />
                    <TextBlock Text="重置" Style="{StaticResource ChipLabel}" />
                    <TextBox x:Name="TxtSkipKey" Style="{StaticResource KbdBox}" Text="Down" Width="46" />
                    <TextBlock Text="跳过" Style="{StaticResource ChipLabel}" />

                    <TextBlock Text="跳过数" Style="{StaticResource ChipLabel}" Margin="6,0,5,0" />
                    <Grid Width="36" Height="22" VerticalAlignment="Center">
                        <TextBox x:Name="TxtSkipCount" Style="{StaticResource KbdBox}" Width="36" />
                        <TextBlock Text="自动" FontSize="10" IsHitTestVisible="False"
                                   Foreground="{StaticResource TextFaintBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSkipCount}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock x:Name="TxtSkipAuto" FontSize="10" Foreground="{StaticResource TextFaintBrush}"
                               VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis"
                               Margin="0,0,10,0" Text="留空 = 自动（当前 0 项）" />
                </StackPanel>

                <Button x:Name="BtnMenu" Grid.Column="2" Content="设置 ▾"
                        Style="{StaticResource QuietButton}" Width="62" Height="26"
                        FontSize="10.5" VerticalAlignment="Center" Click="BtnMenu_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ActionMenu" FontFamily="Microsoft YaHei UI" FontSize="12">
                            <MenuItem x:Name="MiSave" Header="保存配置" Click="SaveConfig_Click" />
                            <MenuItem x:Name="MiLoad" Header="读取配置" Click="LoadConfig_Click" />
                            <MenuItem x:Name="MiUpdate" Header="检查更新" Click="CheckUpdate_Click" />
                            <Separator />
                            <MenuItem x:Name="MiBeep" Header="提示音" IsCheckable="True" Click="Option_Click" />
                            <MenuItem x:Name="MiCloseToTray" Header="关闭窗口时隐藏到托盘" IsCheckable="True" Click="Option_Click" />
                            <MenuItem x:Name="MiTopMost" Header="窗口置顶" IsCheckable="True" Click="Option_Click" />
                            <MenuItem x:Name="MiAutoUpdate" Header="启动时检查更新" IsCheckable="True" Click="Option_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Grid>

        <!-- ============ 状态行：整句话在左，四个读数在右 ============ -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtState" Grid.Column="0" FontSize="10.5"
                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Text="状态：已停止。" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        ToolTip="{Binding Text, ElementName=TxtProgress}">
                <TextBlock Text="本轮" FontSize="9.5" Foreground="{StaticResource TextFaintBrush}"
                           VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock x:Name="TxtMetricRound" Text="0 / 9" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="累计" FontSize="9.5" Foreground="{StaticResource TextFaintBrush}"
                           VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock x:Name="TxtMetricTotal" Text="0" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="下轮" FontSize="9.5" Foreground="{StaticResource TextFaintBrush}"
                           VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock x:Name="TxtMetricNext" Text="1" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="跳过" FontSize="9.5" Foreground="{StaticResource TextFaintBrush}"
                           VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock x:Name="TxtMetricSkip" Text="0" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 代码仍会写这两个元素，但这一版不显示：摘要挂在开始按钮的提示里，明细挂在读数上 -->
        <TextBlock x:Name="TxtSummary" Visibility="Collapsed" Text="本次执行：未勾选任何行" />
        <TextBlock x:Name="TxtProgress" Visibility="Collapsed" Text="暂无启用的按键。" />
    </Grid>
</Window>
